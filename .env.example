# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# Reed: free key from https://www.reed.co.uk/developers
REED_API_KEY=

# Adzuna: free app id + key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Apify: token from https://console.apify.com/account/integrations
# Used for the LinkedIn adapter only. Leave blank to disable LinkedIn.
APIFY_TOKEN=

# Profile
HOME_POSTCODE=LE11
MAX_COMMUTE_MILES=50
SALARY_FLOOR=28000
NEEDS_SPONSORSHIP=false
HAS_CLEARANCE=false

# Pipeline
MATCH_THRESHOLD=55
ALIGNMENT_TARGET=90
DAILY_JOB_CAP=80
LLM_MODEL=claude-sonnet-5
DATABASE_URL=sqlite:///data/jobs.db
